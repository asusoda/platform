# Builds the officer dashboard and the member store (dashboard/) and serves them on port 5000.
FROM node:22-alpine AS builder
WORKDIR /app
COPY dashboard/package.json dashboard/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY dashboard/ ./
# The API URL and the landing site URL go into the bundle at build time.
ARG VITE_API_URL
ARG VITE_SITE_URL
ENV VITE_API_URL=$VITE_API_URL VITE_SITE_URL=$VITE_SITE_URL
RUN npm run build

FROM node:22-alpine
RUN npm install -g serve@14 && addgroup -g 1001 -S nodejs && adduser -S appuser -u 1001
WORKDIR /app
COPY --from=builder --chown=appuser:nodejs /app/dist ./dist
USER appuser
EXPOSE 5000
CMD ["serve", "-s", "dist", "-l", "5000"]
