    "properties": {
     "id": {
      "type": "string"
     },
     "key": {
      "type": "string"
     },
     "value": {
      "type": "string"
     }
    },
    "required": [
     "id",
     "key",
     "value"
    ],
    "type": "object"
   },
   "UpdatePodMounts": {
    "additionalProperties": false,
    "properties": {
     "global": {
      "items": {
       "$ref": "#/components/schemas/GlobalMountPatch"
      },
      "maxItems": 2,
      "type": "array"
     },
     "network": {
      "items": {
       "$ref": "#/components/schemas/NetworkMountPatch"
