    "type": "string"
   },
   "PodGlobalNetworking": {
    "properties": {
     "enabled": {
      "type": "boolean"
     },
     "internalDns": {
      "type": "string"
     },
     "ip": {
      "type": "string"
     }
    },
    "required": [
     "enabled"
    ],
    "type": "object"
   },
   "PodGpuUtilization": {
    "properties": {
     "memoryUtil": {
      "type": "integer"
     },
     "util": {
      "type": "integer"
     }
    },
    "type": "object"
   },
   "PodList": {
    "properties": {
     "pods": {
      "items": {
       "$ref": "#/components/schemas/Pod"
      },
      "type": "array"
     }
    },
    "required": [
     "pods"
    ],
    "type": "object"
   },
   "PodQueueAllowedHours": {
    "properties": {
     "friday": {
      "$ref": "#/components/schemas/PodQueueHours"
     },
     "monday": {
      "$ref": "#/components/schemas/PodQueueHours"
     },
     "saturday": {
      "$ref": "#/components/schemas/PodQueueHours"
     },
     "sunday": {
      "$ref": "#/components/schemas/PodQueueHours"
     },
     "thursday": {
      "$ref": "#/components/schemas/PodQueueHours"
     },
     "tuesday": {
      "$ref": "#/components/schemas/PodQueueHours"
     },
     "wednesday": {
      "$ref": "#/components/schemas/PodQueueHours"
     }
    },
    "type": "object",
    "unevaluatedProperties": false
   },
   "PodQueueHours": {
    "items": {
     "maximum": 23,
     "minimum": 0,
     "type": "integer"
    },
    "type": "array"
   },
   "PodQueueOptions": {
    "properties": {
     "allowedHours": {
      "$ref": "#/components/schemas/PodQueueAllowedHours"
     },
     "expiresAt": {
      "format": "date-time",
      "type": "string"
     },
     "notifyEmail": {
      "format": "email",
      "type": "string"
     },
     "startsAt": {
      "format": "date-time",
      "type": "string"
     }
    },
    "type": "object",
    "unevaluatedProperties": false
   },
   "PodRuntime": {
