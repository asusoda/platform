     "cpu": {
      "$ref": "#/components/schemas/Utilization"
     },
     "gpus": {
      "items": {
       "$ref": "#/components/schemas/PodGpuUtilization"
      },
      "type": "array"
     },
     "memory": {
      "$ref": "#/components/schemas/Utilization"
     },
     "ports": {
      "items": {
       "$ref": "#/components/schemas/PodRuntimePort"
      },
      "type": "array"
     },
     "uptime": {
      "type": "integer"
     }
    },
    "type": "object"
   },
   "PodRuntimePort": {
    "properties": {
     "ip": {
      "type": [
       "string",
       "null"
      ]
     },
     "private": {
      "type": "integer"
     },
     "public": {
      "type": [
       "integer",
       "null"
      ]
     },
     "type": {
      "type": "string"
     }
    },
    "type": "object"
   },
