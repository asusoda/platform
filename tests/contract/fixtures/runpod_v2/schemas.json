    "properties": {
     "command": {
      "type": "string"
     },
     "host": {
      "type": "string"
     },
     "port": {
      "type": "integer"
     },
     "username": {
      "type": "string"
     }
    },
    "required": [
     "host",
     "port",
     "username",
     "command"
    ],
    "type": "object"
   },
