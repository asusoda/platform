# Platform API base URL, without a trailing slash
VITE_API_URL=http://localhost:8000
# Optional: the URL of the site/ deployment. The sign-in page links to its docs and landing page.
# Without it, the links go to the docs and README on GitHub.
VITE_SITE_URL=
# Optional: a Sentry DSN (Browser JavaScript project). The dashboard then sends browser errors and failed API calls.
VITE_SENTRY_DSN=
# Optional: the environment name on dashboard events. Default: the Vite mode.
VITE_SENTRY_ENVIRONMENT=
